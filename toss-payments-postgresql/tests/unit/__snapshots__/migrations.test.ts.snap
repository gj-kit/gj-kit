-- ── 0001_init ───────────────────────────────────────────────────
CREATE SCHEMA IF NOT EXISTS "toss_payments";

CREATE TABLE "toss_payments".orders (
  order_id    text PRIMARY KEY,
  amount      bigint NOT NULL CHECK (amount >= 0),
  currency    text NOT NULL CHECK (currency IN ('KRW','USD','JPY')),
