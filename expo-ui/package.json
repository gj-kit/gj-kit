{
  "name": "@gj-kit/expo-ui",
  "version": "0.6.0",
  "description": "Type-safe Expo and React Native UI components with token-based light/dark themes, accessibility contracts, and safe-area/keyboard utilities.",
  "keywords": [
    "expo",
    "expo-ui",
    "react-native",
    "react-native-ui",
    "react-native-web",
    "ui-kit",
    "component-library",
    "design-system",
    "typescript",
    "theme",
    "dark-mode",
    "accessibility",
    "data-table",
    "pagination",
    "combobox",
    "searchable-select",
    "table",
    "drawer",
    "safe-area",
    "sheet",
    "keyboard",
    "tailwind"
  ],
  "homepage": "https://gj-kit-expo-ui.expo.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gj-kit/gj-kit.git",
    "directory": "expo-ui"
  },
  "bugs": {
    "url": "https://github.com/gj-kit/gj-kit/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.web.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.web.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.web.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.web.cjs"
        }
      },
      "react-native": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      }
    },
    "./insets": {
      "import": {
        "types": "./dist/insets.d.ts",
        "default": "./dist/insets.js"
      },
      "require": {
        "types": "./dist/insets.d.cts",
        "default": "./dist/insets.cjs"
      }
    },
    "./insets/pure": {
      "import": {
        "types": "./dist/insets/pure.d.ts",
        "default": "./dist/insets/pure.js"
      },
      "require": {
        "types": "./dist/insets/pure.d.cts",
        "default": "./dist/insets/pure.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --env.BUILD_TARGET native && tsup --env.BUILD_TARGET web && node scripts/stamp-provenance.mjs",
    "prepack": "npm run build && node scripts/check-provenance.mjs --require-clean",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --project unit",
    "test:types": "vitest run --project types",
    "check:readme": "corepack pnpm run build && node scripts/check-readme.mjs",
    "test:all": "pnpm run test && pnpm run test:types"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79",
    "react-native-safe-area-context": ">=4",
    "react-native-web": ">=0.21"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.4",
    "jsdom": "^25.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
