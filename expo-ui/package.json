{
  "name": "@gj-kit/expo-ui",
  "version": "0.1.0",
  "description": "Expo/React Native UI 킷 — 토큰이 모든 스타일을 관통하는 테마 시스템(라이트/다크), strings·icons 주입, 키보드·safe-area 유틸. 잘못 쓰면 컴파일 에러가 나는 API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      }
    },
    "./insets": {
      "import": {
        "types": "./dist/insets.d.ts",
        "default": "./dist/insets.js"
      },
      "require": {
        "types": "./dist/insets.d.cts",
        "default": "./dist/insets.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --project unit",
    "test:types": "vitest run --project types",
    "check:readme": "pnpm run build && node scripts/check-readme.mjs",
    "test:all": "pnpm run test && pnpm run test:types"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79",
    "react-native-safe-area-context": ">=4"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.81.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-web": "^0.21.0",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
