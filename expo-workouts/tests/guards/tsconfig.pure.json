{
  // 순수성 **산출물** 가드 픽스처 (설계 §2.4-B).
  //
  // ⚠ `skipLibCheck: false`가 이 파일의 존재 이유다. gj-kit의 기본값인 `true`에서는 `.d.ts`
  //   내부의 TS2304(`Cannot find name 'Document'`)가 **억제되고 파라미터가 any로 붕괴**해,
  //   가드가 통과하면서 아무것도 지키지 않는다(V15 실측).
  //
  // ⚠ `../../tsconfig.base.json`을 extends하지 않는다 — 이 픽스처는 **소비자 tsconfig의 재현**이지
  //   우리 빌드 설정의 파생이 아니다.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": { "@gj-kit/expo-workouts/*": ["../../dist/*"] }
  },
  "include": ["pure-entries.ts"]
}
