{
  // 테스트 전용 — jsdom(web) 테스트가 DOM 타입을, 가드가 node:fs 타입을 요구한다.
  // src의 무DOM·무전역타이머 규율은 tsconfig.json이 따로 검사하므로 여기서 DOM/node를
  // 켜도 라이브러리 코드의 전역 유입은 여전히 차단된다 (설계 문서 §2.4).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "tests"]
}
