# 토스페이먼츠 테스트 환경 키 (개발자센터 > API 키)
# API 개별연동용 키 (서버 API: 승인/조회/취소/빌링)
TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
# 보안 키 (64자 hex) — 웹훅 서명 검증(payout/seller) + 지급대행 JWE 암호화
TOSS_SECURITY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 결제위젯용 키 (위젯 E2E 테스트에 필요 — 미발급 시 위젯은 단위/타입 테스트만 가능)
TOSS_WIDGET_CLIENT_KEY=test_gck_xxxxxxxxxxxxxxxxxxxx
TOSS_WIDGET_SECRET_KEY=test_gsk_xxxxxxxxxxxxxxxxxxxx

# @gj-kit/toss-payments-postgresql 통합 테스트용 PostgreSQL 접속 URL
# 동봉된 docker-compose 기본값과 일치한다 (호스트 포트 55432 — 로컬 PG 5432 충돌 회피):
#   docker compose -f toss-payments-postgresql/docker-compose.yml up -d --wait
TOSS_PG_TEST_DATABASE_URL=postgres://toss_pg_test:toss_pg_test@localhost:55432/toss_pg_test
