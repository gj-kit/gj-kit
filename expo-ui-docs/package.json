{
  "name": "@gj-kit/expo-ui-docs",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "generate:seo": "node scripts/generate-seo.mjs",
    "export:web": "pnpm run generate:seo && expo export --platform web",
