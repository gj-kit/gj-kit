{
  // 무DOM **dist** 가드 픽스처 (설계 문서 §2.4 · §5.3 — expo-media 전문 계승).
  //
  // ⚠ `skipLibCheck: false`가 이 파일의 존재 이유다. 기본값 `true`에서는 `.d.ts` 내부의
  //   TS2304가 억제되고 파라미터가 any로 붕괴해, 가드가 통과하면서 아무것도 지키지 않는다.
  // ⚠ `types: []`가 없으면 @types/node가 딸려 들어와 전역이 우연히 해석된다.
  // ⚠ 루트 tsconfig.base.json을 extends하지 않는다 — 이 픽스처는 소비자 tsconfig의 재현이다.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": { "@gj-kit/expo-auth/*": ["../../dist/*"] }
  },
  "include": ["nodom-entries.ts"]
}
