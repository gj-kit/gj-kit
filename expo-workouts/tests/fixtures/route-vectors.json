  "$schema": {
    "window": "hygiene 벡터가 쓰는 워크아웃 창 `[startMs, endMs)`.",
    "hygiene": "{ name, points, throws? , survivorTimes?, survivorLats? } — `normalizeRouteForWrite(points, window)`의 결과. `throws`가 있으면 그 공개 코드로 거절해야 하고, 없으면 살아남는 점의 `t`(그리고 필요하면 `lat`)가 정확히 survivor*와 같아야 한다.",
    "sentinels": "{ name, input, expect } — 읽기 방향 sentinel 정리(f83). `expect`의 `null`은 `undefined`(모름)를 뜻한다. JSON에 undefined가 없어서 null로 적는다.",
    "sizeVectors": "{ routePoints, clientRecordIdLength, titleLength?, notesLength?, segments?, laps?, bytes, accepted } — f100의 공식 결과와 20 000점 쓰기 가드의 판정.",
    "derived": "{ name, fn, points, arg?, expect } — 파생 유틸의 골든 벡터. fn ∈ 'routeDistanceM' | 'routeElevationGainM' | 'derivePauses'. 부동소수는 `tolerance`가 있으면 그 절대 오차 안에서 비교한다.",
    "chunking": "{ points, chunkSizes } — `getRoute()`가 내야 하는 청크 크기 수열(f78 · D8의 1000점). 상수 자체는 공개하지 않지만 **관측 가능한 결과**는 세 언어가 같아야 한다."
  },
