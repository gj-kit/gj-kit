# The example is NOT a pnpm workspace member (root `pnpm-workspace.yaml` is `packages: ["*"]`,
# which matches direct children of the repo root only). Install it with plain `npm install`.
# If you prefer pnpm, run `pnpm install --ignore-workspace --node-linker=hoisted` — React Native's
# Metro and Gradle both need a hoisted layout.
node-linker=hoisted
