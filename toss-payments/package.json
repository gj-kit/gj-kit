{
  "name": "@gj-kit/toss-payments",
  "version": "0.4.0",
  "description": "토스페이먼츠 결제위젯·API v2 연동 라이브러리 — 검증(금액 대조·상태 확인·서명 검증)을 타입으로 강제한다",
  "homepage": "https://github.com/gj-kit/gj-kit/tree/main/toss-payments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gj-kit/gj-kit.git",
    "directory": "toss-payments"
  },
  "bugs": {
    "url": "https://github.com/gj-kit/gj-kit/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "node": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "node": "./dist/server.cjs"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/webhook.d.ts",
        "default": "./dist/webhook.js"
      },
      "require": {
        "types": "./dist/webhook.d.cts",
        "default": "./dist/webhook.cjs"
      }
    },
    "./browser": {
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/stamp-provenance.mjs",
    "prepack": "npm run build && node scripts/check-provenance.mjs --require-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:types": "vitest run --project types",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:readme": "corepack pnpm run build && node scripts/check-readme.mjs",
    "test:all": "pnpm run test && pnpm run test:types && pnpm run test:integration"
  },
  "peerDependencies": {
    "@tosspayments/tosspayments-sdk": "^2"
  },
  "peerDependenciesMeta": {
    "@tosspayments/tosspayments-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tosspayments/tosspayments-sdk": "^2",
    "@types/node": "^24",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
