{
  // 테스트 전용 — 가드 테스트가 node:fs로 소스/산출물을 스캔하고 타입 테스트가
  // @nestjs/* 타입을 읽는다.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
